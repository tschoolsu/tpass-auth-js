{
  "name": "tpass-auth-js",
  "version": "1.0.0",
  "description": "T-Pass SSO 消費端驗章套件（契約 v2）：JWKS 本地驗章、per-service audience、host-only cookie、Next.js callback/logout route handler。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tschoolsu/tpass-auth-js.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "peerDependencies": {
    "jose": "^6.0.0",
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
